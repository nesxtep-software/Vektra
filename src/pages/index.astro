---
import Layout from '../layouts/Layout.astro';
import MetricCards from '../components/MetricCards.astro';
import MaturityChart from '../components/MaturityChart.astro';
import ActivityMatrix from '../components/ActivityMatrix.astro';
import TechStackBreakdown from '../components/TechStackBreakdown.astro';
import AppTable from '../components/AppTable.astro';
import SimpleChart from '../components/SimpleChart.tsx';
import telemetry from '../data/portfolio-telemetry.json';
---

<Layout title="Dashboard">
  <div class="mb-8 flex justify-between items-start">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Portfolio Dashboard</h2>
      <p class="text-gray-600">
        Track developmental progress across all nesxtep-software repositories
      </p>
      <p class="text-sm text-gray-400 mt-1">
        Last updated: {new Date(telemetry.generatedAt).toLocaleString()}
      </p>
    </div>
    <button
      id="refresh-btn"
      class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      Refresh Data
    </button>
  </div>

  <MetricCards />

  <!-- Hardcoded test chart for PoC -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-8">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Test Chart (Hardcoded Data)</h3>
    <SimpleChart client:load />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <MaturityChart />
    <TechStackBreakdown />
  </div>

  <ActivityMatrix />

  <h3 class="text-2xl font-bold text-gray-900 mb-4">Application Details</h3>
  <AppTable />

  <script>
    // @ts-ignore - Inline script in Astro, types not applicable
    const refreshBtn = document.getElementById('refresh-btn') as HTMLButtonElement;

    refreshBtn?.addEventListener('click', () => {
      alert('To refresh data:\n\n1. Run this command in your terminal:\n   cd C:\\repos\\pro\\vektra && mise run ingest\n\n2. Then refresh this page\n\nThis requires gh-cli to be authenticated.');
    });
  </script>
</Layout>
